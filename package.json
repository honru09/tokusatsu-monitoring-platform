{
  "name": "tokusatsu-monitoring-platform",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm --filter @tokusatsu/shared build && pnpm --filter @tokusatsu/db build && pnpm --filter @tokusatsu/classification build && pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @tokusatsu/db generate",
    "db:migrate": "pnpm --filter @tokusatsu/db migrate:dev",
    "db:seed": "pnpm --filter @tokusatsu/db seed",
    "compose:up": "docker compose -f infrastructure/docker-compose.yml up -d --build",
    "compose:down": "docker compose -f infrastructure/docker-compose.yml down",
    "compose:logs": "docker compose -f infrastructure/docker-compose.yml logs -f"
  },
  "devDependencies": {
    "@types/node": "22.18.1",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
