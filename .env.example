AI_ROUTE_SILICONFLOW_LOGISTICS_ANALYSIS=Qwen/Qwen2.5-7B-Instruct|deepseek-ai/DeepSeek-V4-Flash
AI_ROUTE_SILICONFLOW_ASSISTANT_CHAT=deepseek-ai/DeepSeek-V4-Flash|Qwen/Qwen2.5-7B-Instruct|Qwen/Qwen3-Coder-30B-A3B-Instruct
# Cerebras shared API currently exposes GPT-OSS publicly; Gemma remains a
# credential/catalogue-gated candidate and is skipped when it is unavailable.
AI_ROUTE_CEREBRAS_BULK_FILTER=gemma-4-31b|gpt-oss-120b
AI_ROUTE_CEREBRAS_TRANSLATION=gemma-4-31b|gpt-oss-120b
