AI_ROUTE_CLOUDFLARE_CLASSIFICATION=@cf/google/gemma-4-26b-a4b-it|@cf/zai-org/glm-4.7-flash|@cf/openai/gpt-oss-120b
AI_ROUTE_CLOUDFLARE_IMAGE_ANALYSIS=@cf/meta/llama-3.2-11b-vision-instruct
AI_ROUTE_CLOUDFLARE_SELLER_ANALYSIS=@cf/zai-org/glm-4.7-flash|@cf/nvidia/nemotron-3-120b-a12b|@cf/openai/gpt-oss-120b
AI_ROUTE_CLOUDFLARE_COMPLEX_ANALYSIS=@cf/nvidia/nemotron-3-120b-a12b|@cf/openai/gpt-oss-120b|@cf/zai-org/glm-4.7-flash
AI_ROUTE_CLOUDFLARE_CROSS_VALIDATION=@cf/nvidia/nemotron-3-120b-a12b|@cf/openai/gpt-oss-120b|@cf/zai-org/glm-4.7-flash
AI_ROUTE_CLOUDFLARE_MARKET_ANALYSIS=@cf/nvidia/nemotron-3-120b-a12b|@cf/zai-org/glm-4.7-flash|@cf/openai/gpt-oss-120b
AI_ROUTE_CLOUDFLARE_CRAWLER_DIAGNOSIS=@cf/openai/gpt-oss-120b|@cf/nvidia/nemotron-3-120b-a12b|@cf/zai-org/glm-4.7-flash
AI_ROUTE_CLOUDFLARE_LOGISTICS_ANALYSIS=@cf/zai-org/glm-4.7-flash|@cf/google/gemma-4-26b-a4b-it
AI_ROUTE_CLOUDFLARE_ASSISTANT_CHAT=@cf/zai-org/glm-4.7-flash|@cf/google/gemma-4-26b-a4b-it|@cf/nvidia/nemotron-3-120b-a12b
# Cohere is disabled unless an operator explicitly authorizes either internal
# evaluation or production. A key alone never makes it a production candidate.
AI_ROUTE_COHERE_BULK_FILTER=command-a-plus-05-2026|command-a-reasoning-08-2025
AI_ROUTE_COHERE_TRANSLATION=command-a-translate-08-2025|command-a-plus-05-2026
