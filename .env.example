POSTGRES_DB=tokusatsu
POSTGRES_USER=tokusatsu
POSTGRES_PASSWORD=change-me-in-production
DATABASE_URL=postgresql://tokusatsu:change-me-in-production@postgres:5432/tokusatsu?schema=public
REDIS_URL=redis://redis:6379
API_PORT=3001
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3000
REAL_ADAPTER_ENABLED=true
MOCK_ADAPTER_ENABLED=false
# The former public order search currently redirects to the corporate home page.
# Keep this off until Mandarake restores a public, robots-permitted catalogue URL.
MANDARAKE_SEARCH_ENABLED=false
MERCARI_SEARCH_ENABLED=true
YAHOO_AUCTIONS_SEARCH_ENABLED=true
YAHOO_FLEAMARKET_SEARCH_ENABLED=true
YAHOO_SHOPPING_SEARCH_ENABLED=true
# Yahoo Shopping's official product-search API requires a Shopping Client ID.
# Leave empty to keep the adapter safely disabled.
YAHOO_SHOPPING_CLIENT_ID=
YAHOO_SHOPPING_API_URL=https://shopping.yahooapis.jp/ShoppingWebService/V3/itemSearch
YAHOO_SHOPPING_SEARCH_INTERVAL_MS=7200000
YAHOO_SHOPPING_CRAWL_DELAY_MS=1100
RAKUMA_SEARCH_ENABLED=true
SURUGAYA_SEARCH_ENABLED=true
MANDARAKE_SEARCH_KEYWORD=仮面ライダー まとめ売り
CRAWLER_USER_AGENT=TokusatsuMonitor/1.0 (+mailto:operator@example.com)
CRAWLER_CONTACT=operator@example.com
MOCK_SEARCH_INTERVAL_MS=900000
REAL_HIGH_PRIORITY_INTERVAL_MS=600000
REAL_SEARCH_INTERVAL_MS=1800000
MERCARI_SEARCH_INTERVAL_MS=1800000
YAHOO_FLEAMARKET_SEARCH_INTERVAL_MS=3600000
RAKUMA_SEARCH_INTERVAL_MS=7200000
SURUGAYA_SEARCH_INTERVAL_MS=10800000
YAHOO_FLEAMARKET_BACKFILL_INTERVAL_MS=21600000
RAKUMA_BACKFILL_INTERVAL_MS=28800000
YAHOO_FLEAMARKET_CRAWL_DELAY_MS=5000
RAKUMA_CRAWL_DELAY_MS=3000
# Surugaya robots.txt declares Crawl-delay: 30 for wildcard crawlers.
SURUGAYA_CRAWL_DELAY_MS=30000
MANDARAKE_NORMAL_KEYWORD=仮面ライダー
MARKET_KEYWORDS=仮面ライダー|仮面ライダー まとめ売り|仮面ライダー DX|仮面ライダー ベルト|仮面ライダー ソフビ|仮面ライダー 食玩|仮面ライダー ガシャポン|ウルトラマン|特撮 まとめ売り
MARKET_INCREMENTAL_INTERVAL_MS=900000
MARKET_BACKFILL_INTERVAL_MS=10800000
MARKET_BACKFILL_MAX_PAGES=80
FIRECRAWL_DISCOVERY_ENABLED=false
FIRECRAWL_DISCOVERY_INTERVAL_MS=7200000
FIRECRAWL_API_KEY=
FIRECRAWL_API_URL=https://api.firecrawl.dev
FIRECRAWL_INCLUDE_DOMAINS=jp.mercari.com,item.fril.jp,www.suruga-ya.jp,order.mandarake.co.jp,paypayfleamarket.yahoo.co.jp,item.rakuten.co.jp,www.amazon.co.jp,www.ebay.com,netmall.hardoff.co.jp,store.shopping.yahoo.co.jp
FIRECRAWL_ALLOW_ANY_DOMAIN=false
APIFY_ECOMMERCE_ENABLED=false
APIFY_TOKEN=
APIFY_ECOMMERCE_ACTOR=apify~e-commerce-scraping-tool
APIFY_MARKETPLACES=www.amazon.co.jp,item.rakuten.co.jp,www.ebay.com,store.shopping.yahoo.co.jp,netmall.hardoff.co.jp
APIFY_DISCOVERY_INTERVAL_MS=21600000
PLAYWRIGHT_WS_ENDPOINT=
PLAYWRIGHT_EXECUTABLE_PATH=
INVENTORY_CLEANUP_INTERVAL_MS=7200000
BAI_API_KEY=
BAI_API_URL=https://api.b.ai/v1
AI_INTERNAL_TOKEN=replace-with-a-long-random-token
AI_TIMEOUT_MS=120000
AI_MEMORY_REFRESH_INTERVAL_MS=86400000
# Optional model routes, separated by |. The API rejects every model outside
# the six-model B.AI registry even if an environment override contains it.
AI_ROUTE_BULK_FILTER=mimo-v2.5|deepseek-v4-flash|glm-5.3-flash
AI_ROUTE_TRANSLATION=mimo-v2.5|deepseek-v4-flash|glm-5.3-flash
AI_ROUTE_CLASSIFICATION=mimo-v2.5|deepseek-v4-flash|glm-5.3-flash
AI_ROUTE_IMAGE_ANALYSIS=deepseek-v4-flash-vision-exp|mimo-v2.5|glm-5.3-flash
AI_ROUTE_SELLER_ANALYSIS=mimo-v2.5|deepseek-v4-flash|glm-5.3-flash
AI_ROUTE_COMPLEX_ANALYSIS=glm-5.3-flash|qwen3.8-flash|mimo-v2.5
AI_ROUTE_CROSS_VALIDATION=glm-5.3-flash|qwen3.8-flash|mimo-v2.5
AI_ROUTE_MARKET_ANALYSIS=glm-5.3-flash|qwen3.8-flash|mimo-v2.5
AI_ROUTE_CRAWLER_DIAGNOSIS=hy3|glm-5.3-flash|qwen3.8-flash
AI_ROUTE_LOGISTICS_ANALYSIS=mimo-v2.5|glm-5.3-flash|deepseek-v4-flash
AI_ROUTE_ASSISTANT_CHAT=glm-5.3-flash|qwen3.8-flash|mimo-v2.5
MARKET_INTEL_INTERVAL_MS=3600000
MARKET_INTEL_MAX_AGE_DAYS=90
TITLE_TRANSLATION_INTERVAL_MS=15000
DETAIL_TRANSLATION_INTERVAL_MS=15000
TITLE_TRANSLATION_BATCH_SIZE=2
DETAIL_TRANSLATION_BATCH_SIZE=2
LOG_LEVEL=info
SENTRY_DSN=
