AI_ROUTE_OPENROUTER_ASSISTANT_CHAT=deepseek/deepseek-v4-flash|z-ai/glm-5.2:free|minimax/minimax-m3:free
MARKET_INTEL_INTERVAL_MS=3600000
MARKET_INTEL_MAX_AGE_DAYS=90
