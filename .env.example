POSTGRES_DB=tokusatsu
POSTGRES_USER=tokusatsu
POSTGRES_PASSWORD=change-me-in-production
DATABASE_URL=postgresql://tokusatsu:change-me-in-production@postgres:5432/tokusatsu?schema=public
REDIS_URL=redis://redis:6379
API_PORT=3001
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3000
REAL_ADAPTER_ENABLED=true
MOCK_ADAPTER_ENABLED=false
# The former public order search currently redirects to the corporate home page.
# Keep this off until Mandarake restores a public, robots-permitted catalogue URL.
MANDARAKE_SEARCH_ENABLED=false
MERCARI_SEARCH_ENABLED=true
YAHOO_AUCTIONS_SEARCH_ENABLED=true
YAHOO_FLEAMARKET_SEARCH_ENABLED=true
YAHOO_SHOPPING_SEARCH_ENABLED=true
# Yahoo Shopping's official product-search API requires a Shopping Client ID.
# Leave empty to keep the adapter safely disabled.
YAHOO_SHOPPING_CLIENT_ID=
YAHOO_SHOPPING_API_URL=https://shopping.yahooapis.jp/ShoppingWebService/V3/itemSearch
YAHOO_SHOPPING_SEARCH_INTERVAL_MS=7200000
YAHOO_SHOPPING_CRAWL_DELAY_MS=1100
RAKUMA_SEARCH_ENABLED=true
SURUGAYA_SEARCH_ENABLED=true
MANDARAKE_SEARCH_KEYWORD=仮面ライダー まとめ売り
CRAWLER_USER_AGENT=TokusatsuMonitor/1.0 (+mailto:operator@example.com)
CRAWLER_CONTACT=operator@example.com
MOCK_SEARCH_INTERVAL_MS=900000
REAL_HIGH_PRIORITY_INTERVAL_MS=600000
REAL_SEARCH_INTERVAL_MS=1800000
MERCARI_SEARCH_INTERVAL_MS=1800000
YAHOO_FLEAMARKET_SEARCH_INTERVAL_MS=3600000
RAKUMA_SEARCH_INTERVAL_MS=7200000
SURUGAYA_SEARCH_INTERVAL_MS=10800000
YAHOO_FLEAMARKET_BACKFILL_INTERVAL_MS=21600000
RAKUMA_BACKFILL_INTERVAL_MS=28800000
YAHOO_FLEAMARKET_CRAWL_DELAY_MS=5000
RAKUMA_CRAWL_DELAY_MS=3000
# Surugaya robots.txt declares Crawl-delay: 30 for wildcard crawlers.
SURUGAYA_CRAWL_DELAY_MS=30000
MANDARAKE_NORMAL_KEYWORD=仮面ライダー
MARKET_KEYWORDS=仮面ライダー|仮面ライダー まとめ売り|仮面ライダー DX|仮面ライダー ベルト|仮面ライダー ソフビ|仮面ライダー 食玩|仮面ライダー ガシャポン|ウルトラマン|特撮 まとめ売り
MARKET_INCREMENTAL_INTERVAL_MS=900000
MARKET_BACKFILL_INTERVAL_MS=10800000
MARKET_BACKFILL_MAX_PAGES=80
FIRECRAWL_DISCOVERY_ENABLED=false
FIRECRAWL_DISCOVERY_INTERVAL_MS=7200000
FIRECRAWL_API_KEY=
FIRECRAWL_API_URL=https://api.firecrawl.dev
FIRECRAWL_INCLUDE_DOMAINS=jp.mercari.com,item.fril.jp,www.suruga-ya.jp,order.mandarake.co.jp,paypayfleamarket.yahoo.co.jp,item.rakuten.co.jp,www.amazon.co.jp,www.ebay.com,netmall.hardoff.co.jp,store.shopping.yahoo.co.jp
FIRECRAWL_ALLOW_ANY_DOMAIN=false
APIFY_ECOMMERCE_ENABLED=false
APIFY_TOKEN=
APIFY_ECOMMERCE_ACTOR=apify~e-commerce-scraping-tool
APIFY_MARKETPLACES=www.amazon.co.jp,item.rakuten.co.jp,www.ebay.com,store.shopping.yahoo.co.jp,netmall.hardoff.co.jp
APIFY_DISCOVERY_INTERVAL_MS=21600000
PLAYWRIGHT_WS_ENDPOINT=
PLAYWRIGHT_EXECUTABLE_PATH=
INVENTORY_CLEANUP_INTERVAL_MS=7200000
BAI_API_KEY=
BAI_API_URL=https://api.b.ai/v1
GEMINI_API_KEY=
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_API_TIER=unknown
GROQ_API_KEY=
GROQ_API_URL=https://api.groq.com/openai/v1
GROQ_API_TIER=unknown
SILICONFLOW_API_KEY=
SILICONFLOW_API_URL=https://api.siliconflow.cn/v1
SILICONFLOW_API_TIER=unknown
SILICONFLOW_FREE_MODELS=tencent/Hunyuan-MT-7B|Qwen/Qwen2.5-7B-Instruct
NVIDIA_API_KEY=
NVIDIA_API_URL=https://integrate.api.nvidia.com/v1
# NVIDIA-hosted Developer endpoints are trial-only for internal evaluation.
# Production stays disabled unless a valid production subscription authorizes it.
NVIDIA_API_TIER=unknown
NVIDIA_PRODUCTION_AUTHORIZED=false
NVIDIA_INTERNAL_EVALUATION=false
NVIDIA_PRIVATE_DATA_AUTHORIZED=false
CEREBRAS_API_KEY=
CEREBRAS_API_URL=https://api.cerebras.ai/v1
CEREBRAS_API_TIER=unknown
CEREBRAS_PRIVATE_DATA_AUTHORIZED=false
CLOUDFLARE_AI_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_API_URL=https://api.cloudflare.com/client/v4/accounts/{account_id}/ai/v1
CLOUDFLARE_AI_API_TIER=unknown
CLOUDFLARE_AI_ALLOW_OVERAGE=false
CLOUDFLARE_AI_DAILY_NEURON_BUDGET=8000
CLOUDFLARE_AI_PRIVATE_DATA_AUTHORIZED=false
COHERE_API_KEY=
COHERE_API_URL=https://api.cohere.ai/compatibility/v1
COHERE_API_TIER=unknown
# Trial/evaluation and production use are separately opt-in. Production use of
# the newer Command A family may require Cohere approval in addition to a key.
COHERE_INTERNAL_EVALUATION=false
COHERE_PRODUCTION_AUTHORIZED=false
COHERE_PRIVATE_DATA_AUTHORIZED=false
SENSENOVA_API_KEY=
SENSENOVA_TRANSLATION_API_KEY=
SENSENOVA_API_URL=https://api.sensenova.cn/compatible-mode/v2
# SenseNova is paid/unknown by default and never enters free_only routing
# unless an operator explicitly verifies a promotion.
SENSENOVA_API_TIER=unknown
SENSENOVA_PRIVATE_DATA_AUTHORIZED=false
OPENROUTER_API_KEY=
OPENROUTER_API_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=Kamen Procurement
# Default fallback order. Per-task orders below distribute work by capability.
AI_PROVIDER_ORDER=bai|gemini|groq|siliconflow|cerebras|cloudflare|cohere|nvidia|sensenova|openrouter
# Every account/model has its own live quota. The default refuses paid or
# unknown-cost routes; an operator must explicitly authorize any paid policy.
AI_COST_POLICY=free_only
AI_ALLOW_PAID_MODELS=false
# Public chat/diagnose endpoints are isolated from internal execution. Keep
# public requests strictly free by default and bound per-client memory.
AI_PUBLIC_COST_POLICY=free_only
AI_PUBLIC_ALLOW_PAID_MODELS=false
AI_PUBLIC_CHAT_RATE_LIMIT=12
AI_PUBLIC_CHAT_RATE_WINDOW_MS=900000
AI_PUBLIC_DIAGNOSE_RATE_LIMIT=2
AI_PUBLIC_DIAGNOSE_RATE_WINDOW_MS=3600000
AI_PUBLIC_RATE_LIMIT_MAX_BUCKETS=10000
AI_PUBLIC_RATE_LIMIT_CLEANUP_MS=60000
AI_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1,172.16.0.0/12
# Gemini's free tier is eligible only for public_market tasks. The API enforces
# this privacy boundary; there is intentionally no environment bypass.
AI_CATALOG_REFRESH_INTERVAL_MS=21600000
AI_CATALOG_NEGATIVE_CACHE_MS=60000
AI_CATALOG_TIMEOUT_MS=5000
AI_PRICING_VERIFICATION_MAX_AGE_MS=86400000
AI_PROVIDER_CIRCUIT_COOLDOWN_MS=60000
AI_PROVIDER_5XX_COOLDOWN_MS=900000
AI_INTERNAL_TOKEN=replace-with-a-long-random-token
AI_TIMEOUT_MS=30000
AI_MODEL_TIMEOUT_MS=30000
AI_GATEWAY_DEADLINE_MS=240000
AI_GATEWAY_CLIENT_TIMEOUT_MS=270000
AI_HTTP_RETRIES=1
AI_CHAT_PLANNER_ENABLED=false
AI_PROXY_TIMEOUT_MS=270000
AI_MEMORY_REFRESH_INTERVAL_MS=86400000
# Task-specific provider order keeps the pool useful instead of treating all
# services as interchangeable. Missing/unavailable models are skipped at runtime.
AI_PROVIDER_ORDER_BULK_FILTER=groq|cerebras|cloudflare|gemini|siliconflow|bai|nvidia|cohere|sensenova|openrouter
AI_PROVIDER_ORDER_TRANSLATION=gemini|cloudflare|siliconflow|cerebras|nvidia|bai|groq|cohere|sensenova|openrouter
AI_PROVIDER_ORDER_CLASSIFICATION=groq|cerebras|cloudflare|gemini|siliconflow|bai|nvidia|cohere|sensenova|openrouter
AI_PROVIDER_ORDER_IMAGE_ANALYSIS=gemini|bai|cloudflare|cohere|cerebras|siliconflow|groq|sensenova|openrouter
AI_PROVIDER_ORDER_SELLER_ANALYSIS=gemini|groq|cloudflare|cerebras|nvidia|bai|siliconflow|cohere|sensenova|openrouter
AI_PROVIDER_ORDER_COMPLEX_ANALYSIS=gemini|groq|cerebras|cloudflare|nvidia|bai|cohere|sensenova|openrouter|siliconflow
AI_PROVIDER_ORDER_CROSS_VALIDATION=gemini|groq|cerebras|cloudflare|nvidia|bai|cohere|sensenova|siliconflow|openrouter
AI_PROVIDER_ORDER_MARKET_ANALYSIS=groq|gemini|cloudflare|cerebras|nvidia|bai|cohere|sensenova|openrouter|siliconflow
AI_PROVIDER_ORDER_CRAWLER_DIAGNOSIS=gemini|groq|cerebras|cloudflare|nvidia|bai|cohere|sensenova|openrouter|siliconflow
AI_PROVIDER_ORDER_LOGISTICS_ANALYSIS=gemini|cloudflare|cerebras|nvidia|bai|groq|siliconflow|cohere|sensenova|openrouter
AI_PROVIDER_ORDER_ASSISTANT_CHAT=groq|cloudflare|cerebras|gemini|nvidia|bai|cohere|sensenova|siliconflow|openrouter
# Generic B.AI routes, separated by |. Provider-specific routes below use their
# own allowlists and live catalogues; unknown model IDs are always rejected.
AI_ROUTE_BULK_FILTER=mimo-v2.5|deepseek-v4-flash|glm-5.3-flash
AI_ROUTE_TRANSLATION=mimo-v2.5|deepseek-v4-flash|glm-5.3-flash
AI_ROUTE_CLASSIFICATION=mimo-v2.5|deepseek-v4-flash|glm-5.3-flash
AI_ROUTE_IMAGE_ANALYSIS=deepseek-v4-flash-vision-exp|mimo-v2.5|glm-5.3-flash
AI_ROUTE_SELLER_ANALYSIS=mimo-v2.5|deepseek-v4-flash|glm-5.3-flash
AI_ROUTE_COMPLEX_ANALYSIS=glm-5.3-flash|qwen3.8-flash|mimo-v2.5
AI_ROUTE_CROSS_VALIDATION=glm-5.3-flash|qwen3.8-flash|mimo-v2.5
AI_ROUTE_MARKET_ANALYSIS=glm-5.3-flash|qwen3.8-flash|mimo-v2.5
AI_ROUTE_CRAWLER_DIAGNOSIS=hy3|glm-5.3-flash|qwen3.8-flash
AI_ROUTE_LOGISTICS_ANALYSIS=mimo-v2.5|glm-5.3-flash|deepseek-v4-flash
AI_ROUTE_ASSISTANT_CHAT=glm-5.3-flash|qwen3.8-flash|mimo-v2.5
# Gemini routes. Google has announced that Standard API keys stop working in
# September 2026; migrate this credential to an Auth key before then.
AI_ROUTE_GEMINI_BULK_FILTER=gemini-3.5-flash-lite|gemini-flash-lite-latest|gemini-3.7-flash
AI_ROUTE_GEMINI_TRANSLATION=gemini-3.5-flash-lite|gemini-flash-lite-latest|gemini-3.7-flash
AI_ROUTE_GEMINI_CLASSIFICATION=gemini-3.5-flash-lite|gemini-flash-lite-latest|gemini-3.7-flash
AI_ROUTE_GEMINI_IMAGE_ANALYSIS=gemini-3.7-flash|gemini-3.5-flash-lite
AI_ROUTE_GEMINI_SELLER_ANALYSIS=gemini-3.7-flash|gemini-3.5-flash-lite
AI_ROUTE_GEMINI_COMPLEX_ANALYSIS=gemini-3.7-flash|gemini-3.5-flash-lite
AI_ROUTE_GEMINI_CROSS_VALIDATION=gemini-3.7-flash|gemini-3.5-flash-lite
AI_ROUTE_GEMINI_MARKET_ANALYSIS=gemini-3.7-flash|gemini-3.5-flash-lite
AI_ROUTE_GEMINI_CRAWLER_DIAGNOSIS=gemini-3.7-flash|gemini-3.5-flash-lite
AI_ROUTE_GEMINI_LOGISTICS_ANALYSIS=gemini-3.7-flash|gemini-3.5-flash-lite
AI_ROUTE_GEMINI_ASSISTANT_CHAT=gemini-3.7-flash|gemini-3.5-flash-lite
# Groq routes. qwen vision entries are preview spillover, never the only image
# route. The gateway should honor Retry-After and x-ratelimit-* response headers.
AI_ROUTE_GROQ_BULK_FILTER=openai/gpt-oss-20b|openai/gpt-oss-120b
AI_ROUTE_GROQ_TRANSLATION=openai/gpt-oss-20b|qwen/qwen3.8-27b
AI_ROUTE_GROQ_CLASSIFICATION=openai/gpt-oss-20b|openai/gpt-oss-120b
AI_ROUTE_GROQ_IMAGE_ANALYSIS=qwen/qwen3.8-27b
AI_ROUTE_GROQ_SELLER_ANALYSIS=groq/compound|openai/gpt-oss-120b|openai/gpt-oss-20b
AI_ROUTE_GROQ_COMPLEX_ANALYSIS=openai/gpt-oss-120b|groq/compound|openai/gpt-oss-20b
AI_ROUTE_GROQ_CROSS_VALIDATION=openai/gpt-oss-120b|openai/gpt-oss-20b
AI_ROUTE_GROQ_MARKET_ANALYSIS=groq/compound|openai/gpt-oss-120b|openai/gpt-oss-20b
AI_ROUTE_GROQ_CRAWLER_DIAGNOSIS=openai/gpt-oss-120b|groq/compound|openai/gpt-oss-20b
AI_ROUTE_GROQ_LOGISTICS_ANALYSIS=openai/gpt-oss-20b|openai/gpt-oss-120b
AI_ROUTE_GROQ_ASSISTANT_CHAT=openai/gpt-oss-20b|openai/gpt-oss-120b|groq/compound
# SiliconFlow exposes free non-Pro models and paid Pro/ models. Availability,
# price and capability are refreshed/canary-checked before a route is activated.
AI_ROUTE_SILICONFLOW_BULK_FILTER=Qwen/Qwen2.5-7B-Instruct|deepseek-ai/DeepSeek-V4-Flash
AI_ROUTE_SILICONFLOW_TRANSLATION=tencent/Hunyuan-MT-7B|Qwen/Qwen2.5-7B-Instruct|deepseek-ai/DeepSeek-V4-Flash
AI_ROUTE_SILICONFLOW_CLASSIFICATION=Qwen/Qwen2.5-7B-Instruct|deepseek-ai/DeepSeek-V4-Flash
