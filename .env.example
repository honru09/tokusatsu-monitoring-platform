AI_ROUTE_SILICONFLOW_SELLER_ANALYSIS=deepseek-ai/DeepSeek-V4-Flash|Qwen/Qwen3-Coder-30B-A3B-Instruct|Qwen/Qwen2.5-7B-Instruct
