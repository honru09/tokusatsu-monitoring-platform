POSTGRES_DB=tokusatsu
POSTGRES_USER=tokusatsu
POSTGRES_PASSWORD=
DATABASE_URL=
REDIS_URL=redis://redis:6379
API_PORT=3001
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3000
REAL_ADAPTER_ENABLED=true
MOCK_ADAPTER_ENABLED=false
# The former public order search currently redirects to the corporate home page.
# Keep this off until Mandarake restores a public, robots-permitted catalogue URL.
MANDARAKE_SEARCH_ENABLED=false
MERCARI_SEARCH_ENABLED=true
YAHOO_AUCTIONS_SEARCH_ENABLED=true
YAHOO_FLEAMARKET_SEARCH_ENABLED=true
YAHOO_SHOPPING_SEARCH_ENABLED=true
# Yahoo Shopping's official product-search API requires a Shopping Client ID.
# Leave empty to keep the adapter safely disabled.
YAHOO_SHOPPING_CLIENT_ID=
YAHOO_SHOPPING_API_URL=https://shopping.yahooapis.jp/ShoppingWebService/V3/itemSearch
YAHOO_SHOPPING_SEARCH_INTERVAL_MS=7200000
YAHOO_SHOPPING_CRAWL_DELAY_MS=1100
RAKUMA_SEARCH_ENABLED=true
SURUGAYA_SEARCH_ENABLED=true
MANDARAKE_SEARCH_KEYWORD=仮面ライダー まとめ売り
CRAWLER_USER_AGENT=TokusatsuMonitor/1.0 (+mailto:operator@example.com)
CRAWLER_CONTACT=operator@example.com
MOCK_SEARCH_INTERVAL_MS=900000
REAL_HIGH_PRIORITY_INTERVAL_MS=600000
REAL_SEARCH_INTERVAL_MS=1800000
# Optional status-worker overrides. Leave blank to size throughput from the
# active catalogue and keep the complete availability scan within two hours.
STATUS_REFRESH_RPM=
STATUS_REFRESH_CONCURRENCY=
YAHOO_AUCTIONS_CRAWL_DELAY_MS=1000
STATUS_REFRESH_AVERAGE_JOB_MS=15000
MERCARI_SEARCH_INTERVAL_MS=1800000
YAHOO_FLEAMARKET_SEARCH_INTERVAL_MS=3600000
RAKUMA_SEARCH_INTERVAL_MS=7200000
SURUGAYA_SEARCH_INTERVAL_MS=10800000
YAHOO_FLEAMARKET_BACKFILL_INTERVAL_MS=21600000
RAKUMA_BACKFILL_INTERVAL_MS=28800000
YAHOO_FLEAMARKET_CRAWL_DELAY_MS=5000
RAKUMA_CRAWL_DELAY_MS=3000
# Surugaya robots.txt declares Crawl-delay: 30 for wildcard crawlers.
SURUGAYA_CRAWL_DELAY_MS=30000
MANDARAKE_NORMAL_KEYWORD=仮面ライダー
PROCUREMENT_SEARCH_KEYWORDS=仮面ライダー まとめ売り|ウルトラマン まとめ売り|特撮 ガシャポン まとめ売り|特撮 食玩 まとめ売り|特撮 指人形 まとめ売り|特撮 ミニフィギュア まとめ売り|仮面ライダー S.H.Figuarts|仮面ライダー 真骨彫製法|仮面ライダー S.H.Figuarts まとめ売り|仮面ライダー SHF 魂ウェブ商店
# Shared procurement thresholds used by the Worker, discovery, and analysis.
PROCUREMENT_MIN_QUANTITY=5
PROCUREMENT_TARGET_QUANTITY=10
PROCUREMENT_MAX_UNIT_COST_JPY=1000
PROCUREMENT_MAX_VOLUME_CM3=10000
PROCUREMENT_MAX_UNIT_VOLUME_CM3=1000
MARKET_KEYWORDS=仮面ライダー|仮面ライダー まとめ売り|仮面ライダー DX|仮面ライダー ベルト|仮面ライダー ソフビ|仮面ライダー 食玩|仮面ライダー ガシャポン|ウルトラマン|特撮 まとめ売り
MARKET_INCREMENTAL_INTERVAL_MS=900000
MARKET_BACKFILL_INTERVAL_MS=10800000
MARKET_BACKFILL_MAX_PAGES=80
FIRECRAWL_DISCOVERY_ENABLED=false
FIRECRAWL_DISCOVERY_INTERVAL_MS=7200000
FIRECRAWL_API_KEY=
FIRECRAWL_API_URL=https://api.firecrawl.dev
FIRECRAWL_INCLUDE_DOMAINS=jp.mercari.com,item.fril.jp,www.suruga-ya.jp,order.mandarake.co.jp,paypayfleamarket.yahoo.co.jp,item.rakuten.co.jp,www.amazon.co.jp,www.ebay.com,netmall.hardoff.co.jp,store.shopping.yahoo.co.jp
FIRECRAWL_ALLOW_ANY_DOMAIN=false
APIFY_ECOMMERCE_ENABLED=false
APIFY_TOKEN=
APIFY_ECOMMERCE_ACTOR=apify~e-commerce-scraping-tool
APIFY_MARKETPLACES=www.amazon.co.jp,item.rakuten.co.jp,www.ebay.com,store.shopping.yahoo.co.jp,netmall.hardoff.co.jp
APIFY_DISCOVERY_INTERVAL_MS=21600000
# China-market comparison stays inactive until both global gates and the
# source-specific switch are explicitly enabled for an authorized data path.
# It does not require BACKGROUND_AI_PAID_AUTOMATION_ENABLED; AI enrichment is
# optional and deterministic matching remains available when paid AI is off.
CHINA_MARKET_COMPARISON_ENABLED=false
CHINA_MARKET_COMPARISON_AUTHORIZED=false
XIANYU_COMPARISON_ENABLED=false
XIANYU_APIFY_ACTOR=zen-studio~goofish-xianyu-search-scraper
XIANYU_SEARCH_API_URL=
XIANYU_SEARCH_API_TOKEN=
XIANYU_COMPARISON_INTERVAL_MS=21600000
XIANYU_COMPARISON_DISPATCH_INTERVAL_MS=900000
XIANYU_COMPARISON_BATCH_SIZE=20
XIANYU_COMPARISON_NEW_PRODUCT_QUOTA=5
XIANYU_COMPARISON_MAX_KEYWORDS=5
XIANYU_COMPARISON_MAX_CANDIDATES=40
XIANYU_COMPARISON_RPM=1
XIANYU_COMPARISON_MAX_STALE_MS=86400000
XIANYU_COMPARISON_LEASE_MS=600000
XIANYU_COMPARISON_OFFER_RETENTION_DAYS=30
XIANYU_COMPARISON_MAX_STORED_OFFERS=2000
XIANYU_PROVIDER_DEADLINE_MS=180000
XIANYU_REQUEST_INTERVAL_MS=3000
XIANYU_CROSS_MARKET_ARBITRAGE_ENABLED=false
XIANYU_REVERSE_SEARCH_ENABLED=false
XIANYU_ARBITRAGE_MIN_REFERENCE_PRICE_CNY=300
XIANYU_ARBITRAGE_MIN_GROSS_SPREAD_CNY=150
XIANYU_ARBITRAGE_MIN_GROSS_SPREAD_RATIO=0.5
XIANYU_ARBITRAGE_MIN_NET_PROFIT_JPY=5000
XIANYU_ARBITRAGE_MIN_NET_MARGIN_RATIO=0.3
XIANYU_ARBITRAGE_MIN_MATCH_CONFIDENCE=0.85
XIANYU_ARBITRAGE_MAX_COMPARISON_AGE_MS=259200000
XIANYU_ARBITRAGE_MAX_EXCHANGE_RATE_AGE_MS=129600000
XIANYU_ARBITRAGE_MAX_LISTING_AGE_MS=86400000
# These three cost inputs are intentionally blank. Until operators enter
# verified values, the system records needs_facts and never claims net profit.
XIANYU_ARBITRAGE_PLATFORM_FEE_RATE=
XIANYU_ARBITRAGE_INTERNATIONAL_SHIPPING_JPY=
XIANYU_ARBITRAGE_CHINA_FULFILLMENT_CNY=
PLAYWRIGHT_WS_ENDPOINT=
PLAYWRIGHT_EXECUTABLE_PATH=
INVENTORY_CLEANUP_INTERVAL_MS=7200000
# Sole active AI provider. Tokens are covered by the screenshot's gift bundle.
ZHIPU_API_KEY=
ZHIPU_API_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_API_TIER=promotion
ZHIPU_PRIVATE_DATA_AUTHORIZED=true
ZHIPU_FREE_TOKEN_LIMIT=14000000
ZHIPU_DAILY_TOKEN_LIMIT=200000
ZHIPU_FREE_RESOURCE_EXPIRES_AT=2026-11-09T14:35:56+08:00
AI_PROVIDER_ORDER=zhipu
AI_COST_POLICY=free_only
AI_ALLOW_PAID_MODELS=false
AI_PUBLIC_COST_POLICY=free_only
AI_PUBLIC_ALLOW_PAID_MODELS=false
AI_PUBLIC_CHAT_RATE_LIMIT=12
AI_PUBLIC_CHAT_RATE_WINDOW_MS=900000
AI_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1,172.16.0.0/12
AI_INTERNAL_TOKEN=
AI_TIMEOUT_MS=60000
AI_MODEL_TIMEOUT_MS=60000
AI_BACKGROUND_MODEL_TIMEOUT_MS=60000
AI_GATEWAY_DEADLINE_MS=90000
AI_GATEWAY_CLIENT_TIMEOUT_MS=120000
AI_PROXY_TIMEOUT_MS=120000
AI_HTTP_RETRIES=1
AI_CHAT_PLANNER_ENABLED=false
MARKET_INTEL_INTERVAL_MS=3600000
MARKET_INTEL_MAX_AGE_DAYS=90
TITLE_TRANSLATION_INTERVAL_MS=30000
DETAIL_TRANSLATION_INTERVAL_MS=60000
TITLE_TRANSLATION_BATCH_SIZE=4
DETAIL_TRANSLATION_BATCH_SIZE=2
# Automatic enrichment is serialized across queues and worker replicas. The
# modest RPM limits preserve paid capacity for explicit user actions.
BACKGROUND_AI_MAX_CONCURRENCY=1
BACKGROUND_AI_COOLDOWN_MS=600000
# Paid background automation stays off unless explicitly funded. Free-tier
# background automation (translation and image classification) runs by
# default; set it to false to stop all scheduled AI enrichment.
BACKGROUND_AI_PAID_AUTOMATION_ENABLED=false
BACKGROUND_AI_FREE_AUTOMATION_ENABLED=true
IMAGE_CLASSIFICATION_RPM=2
TITLE_TRANSLATION_RPM=2
DETAIL_TRANSLATION_RPM=1
LOG_LEVEL=info
SENTRY_DSN=
# Web Push (VAPID). Leave all three empty to keep push disabled.
# Generate a keypair once with: npx web-push generate-vapid-keys
# VAPID_SUBJECT must be a mailto: address the push services can contact.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Optional bridge implementing docs/RESALE_WORKSPACE.md. Empty means manual publishing.
RESALE_PUBLISHER_URL=
RESALE_PUBLISHER_TOKEN=
RESALE_PUBLISHER_CAPABILITIES=
# Optional read-only JSON search service; falls back to XIANYU_SEARCH_API_URL/TOKEN.
RESALE_MARKET_SEARCH_URL=
RESALE_MARKET_SEARCH_TOKEN=

# Local normal-browser login connection; generate a random token before startup.
XIANYU_SESSION_URL=http://host.docker.internal:3880
XIANYU_SESSION_TOKEN=
