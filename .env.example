AI_ROUTE_OPENROUTER_SELLER_ANALYSIS=deepseek/deepseek-v4-flash|z-ai/glm-5.2:free|minimax/minimax-m3:free
AI_ROUTE_OPENROUTER_COMPLEX_ANALYSIS=deepseek/deepseek-v4-flash|nvidia/nemotron-3-ultra-550b-a55b:free|minimax/minimax-m3:free
