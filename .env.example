AI_ROUTE_CEREBRAS_CRAWLER_DIAGNOSIS=gpt-oss-120b|gemma-4-31b
AI_ROUTE_CEREBRAS_LOGISTICS_ANALYSIS=gemma-4-31b|gpt-oss-120b
AI_ROUTE_CEREBRAS_ASSISTANT_CHAT=gpt-oss-120b|gemma-4-31b
# Cloudflare paid overage is disabled. These candidates may consume only the
# account's current free Neuron allowance while AI_COST_POLICY=free_only.
AI_ROUTE_CLOUDFLARE_BULK_FILTER=@cf/google/gemma-4-26b-a4b-it|@cf/zai-org/glm-4.7-flash|@cf/openai/gpt-oss-120b
